/* 童趣糖果样式表 */

QWidget {
    background-color: #FFF8F5;
    font-family: "Microsoft YaHei UI";
}

/* 标题样式 */
TitleLabel {
    font-size: 28px;
    font-weight: bold;
    color: #FF9EB5;
}

SubtitleLabel {
    font-size: 11px;
    color: #B5A8A8;
}

/* 童趣按钮 */
CandyButton {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #FFBDBD, stop:1 #FF9A9A);
    border-radius: 28px;
    color: white;
    font-size: 17px;
    font-weight: bold;
    padding: 10px 20px;
    border: none;
}

CandyButton:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #FFD0D0, stop:1 #FFB5B5);
}

CandyButton:pressed {
    background: #E57070;
}

CandyButton:disabled {
    background: #E0E0E0;
    color: #A0A0A0;
}

/* 购物清单表格 */
CandyTable {
    background-color: #FFFFFF;
    border-radius: 20px;
    border: 2px dashed #FFB5C5;
}

CandyTable::item {
    height: 52px;
    padding: 5px;
}

CandyTable::item:selected {
    background-color: #FFF0EB;
}

CandyTable::item:hover {
    background-color: #FFF8F5;
}

QHeaderView::section {
    background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #FF9EB5, stop:0.33 #B8E0FF, stop:0.66 #FFE5A0, stop:1 #FF9EB5);
    color: white;
    font-weight: bold;
    padding: 12px;
    border-top-left-radius: 20px;
    border-top-right-radius: 20px;
    border: none;
}

/* 进度条 */
CandyProgressBar {
    background-color: #F5F5F5;
    border-radius: 14px;
    border: none;
    text-align: center;
}

/* 气泡日志 */
BubbleLog {
    background-color: #FFFFFF;
    border-radius: 15px;
}

BubbleMessage {
    background-color: #E3F2FD;
    border-radius: 10px;
    padding: 8px 12px;
    margin: 4px;
    border: 1px solid #B8E0FF;
}

BubbleMessage[type="success"] {
    background-color: #E8F5E9;
    border-color: #B5F2D6;
}

BubbleMessage[type="warning"] {
    background-color: #FFF8E1;
    border-color: #FFE5A0;
}

BubbleMessage[type="error"] {
    background-color: #FFE4EC;
    border-color: #FF9A9A;
}

BubbleMessage[type="lucky"] {
    background-color: #F3E5F5;
    border-color: #D4B5FF;
}
